# Main runtime
APP_ENV=local
BACKEND_BASE_URL=http://127.0.0.1:8000
CHAT_AUTH_MODE=local_open
CHAT_RUNS_PATH=data/chat_runs.jsonl
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Local RAG on Linux
USE_REMOTE_RAG=false
DOCUMENTS_DB_PATH=/home/jose-gonzalez-oliva/LOCALES/DB/chunks/documents.sqlite

# Optional compatibility alias if FastAPI runs on another LAN host:
# BACKEND_URL=http://192.168.1.20:8000

# Optional distributed RAG over LAN
# Set only when FastAPI should call Linux RAG Service remotely.
# USE_REMOTE_RAG=true
RAG_SERVICE_URL=http://192.168.1.51:9000
RAG_TIMEOUT_SECONDS=10
RAG_TOP_K=5

# Operational protected routes
JOSE_DEV_TOKEN=change_me

# Frontend static deploy reference
# This repo does not use Vite/Next/CRA for frontend. The public static UI reads
# BACKEND_BASE_URL from frontend/runtime-config.js instead of build-time env injection.
# Use this value when generating runtime-config.js for Netlify/Vercel/static hosting.
# BACKEND_BASE_URL=https://api.example.com

# Telegram legacy
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_MODEL=granite4.1:8b
TELEGRAM_DEFAULT_TEMPERATURE=0.2
TELEGRAM_DEFAULT_RAG_ENABLED=true
TELEGRAM_ALLOWED_USER_IDS=

# Repo analyzer
REPO_ANALYZER_ENABLED=false
REPO_ANALYZER_PATH=
REPO_ANALYZER_MODEL=granite4.1:8b
REPO_ANALYZER_TEMPERATURE=0.2
